{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:buslink:profile-schema:v1",
  "title": "BusLink device profile, schema v1",
  "$comment": "Structure, enums and ranges for editors. Cross-field rules (support level vs source/evidence, write bounds inside valid_range, command references, commands only on simulated_only profiles, overlap warnings, duplicate JSON keys, null values) are enforced by tools/hooks/check_profile.py and crates/buslink-core/src/profile/validate.rs, which must agree. Reference: docs/profiles/schema-v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "vendor", "model", "support_level", "transport", "registers"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 2000 },
    "$comment": { "type": "string", "maxLength": 2000 },
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$", "minLength": 3, "maxLength": 64 },
    "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "vendor": { "$ref": "#/$defs/text80" },
    "model": { "$ref": "#/$defs/text80" },
    "category": { "$ref": "#/$defs/text40" },
    "firmware": { "$ref": "#/$defs/text80" },
    "description": { "$ref": "#/$defs/text1000" },
    "notes": {
      "oneOf": [
        { "$ref": "#/$defs/text2000" },
        { "type": "array", "items": { "$ref": "#/$defs/text2000" } }
      ]
    },
    "support_level": { "$ref": "#/$defs/level" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": { "$ref": "#/$defs/capLevel" },
        "write": { "$ref": "#/$defs/capLevel" },
        "comm_config": { "$ref": "#/$defs/capLevel" },
        "control": { "$ref": "#/$defs/capLevel" }
      }
    },
    "simulated_only": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "revision"],
      "properties": {
        "document": { "$ref": "#/$defs/text200" },
        "revision": { "$ref": "#/$defs/text80" },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "pages": { "$ref": "#/$defs/text80" },
        "retrieved": { "$ref": "#/$defs/date" },
        "publisher": { "$ref": "#/$defs/text120" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardware": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "adapter", "platform", "record", "result"],
            "properties": {
              "date": { "$ref": "#/$defs/date" },
              "adapter": { "$ref": "#/$defs/text200" },
              "platform": { "$ref": "#/$defs/text200" },
              "firmware": { "$ref": "#/$defs/text80" },
              "unit_id": { "type": "integer", "minimum": 1, "maximum": 255 },
              "record": { "$ref": "#/$defs/text200" },
              "result": { "enum": ["pass", "fail", "partial"] },
              "notes": { "$ref": "#/$defs/text2000" }
            }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "rtu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit_id", "baud", "data_bits", "parity", "stop_bits"],
          "properties": {
            "unit_id": { "type": "integer", "minimum": 1, "maximum": 247, "$comment": "0 is broadcast and is never a device default" },
            "baud": { "type": "integer", "minimum": 300, "maximum": 3000000 },
            "data_bits": { "enum": [7, 8] },
            "parity": { "enum": ["none", "even", "odd"] },
            "stop_bits": { "enum": [1, 2] },
            "response_timeout_ms": { "type": "integer", "minimum": 50, "maximum": 10000 },
            "inter_frame_ms": { "type": "integer", "minimum": 0, "maximum": 1000 }
          }
        },
        "tcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit_id", "port"],
          "properties": {
            "unit_id": { "type": "integer", "minimum": 1, "maximum": 255 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "response_timeout_ms": { "type": "integer", "minimum": 50, "maximum": 10000 }
          }
        },
        "simulator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model"],
          "properties": { "model": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "registers": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/register" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "comm_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "allOf": [
            { "$ref": "#/$defs/commSetting" },
            { "not": { "required": ["codes"] } }
          ]
        },
        "baud": {
          "allOf": [
            { "$ref": "#/$defs/commSetting" },
            { "required": ["codes"] }
          ]
        }
      }
    }
  },
  "$defs": {
    "level": { "enum": ["generic", "documented", "simulated", "hardware_verified"] },
    "capLevel": { "enum": ["generic", "documented", "simulated", "hardware_verified", "unsupported"] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "plain": { "type": "string", "pattern": "\\S", "$comment": "non-blank, no control characters except tab/CR/LF" },
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "id"],
      "properties": { "en": { "$ref": "#/$defs/plain" }, "id": { "$ref": "#/$defs/plain" } }
    },
    "text40": { "oneOf": [ { "allOf": [ { "$ref": "#/$defs/plain" }, { "maxLength": 40 } ] }, { "$ref": "#/$defs/bilingual" } ] },
    "text80": { "oneOf": [ { "allOf": [ { "$ref": "#/$defs/plain" }, { "maxLength": 80 } ] }, { "$ref": "#/$defs/bilingual" } ] },
    "text120": { "oneOf": [ { "allOf": [ { "$ref": "#/$defs/plain" }, { "maxLength": 120 } ] }, { "$ref": "#/$defs/bilingual" } ] },
    "text200": { "oneOf": [ { "allOf": [ { "$ref": "#/$defs/plain" }, { "maxLength": 200 } ] }, { "$ref": "#/$defs/bilingual" } ] },
    "text500": { "oneOf": [ { "allOf": [ { "$ref": "#/$defs/plain" }, { "maxLength": 500 } ] }, { "$ref": "#/$defs/bilingual" } ] },
    "text1000": { "oneOf": [ { "allOf": [ { "$ref": "#/$defs/plain" }, { "maxLength": 1000 } ] }, { "$ref": "#/$defs/bilingual" } ] },
    "text2000": { "oneOf": [ { "allOf": [ { "$ref": "#/$defs/plain" }, { "maxLength": 2000 } ] }, { "$ref": "#/$defs/bilingual" } ] },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "table", "address", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text80" },
        "description": { "$ref": "#/$defs/text500" },
        "table": { "enum": ["coil", "discrete_input", "input_register", "holding_register"] },
        "address": { "type": "integer", "minimum": 0, "maximum": 65535, "$comment": "zero-based PDU offset, never a 4xxxx label" },
        "doc_address": {
          "oneOf": [ { "type": "integer" }, { "type": "string", "minLength": 1, "maxLength": 16 } ],
          "$comment": "the label exactly as printed in the manual"
        },
        "type": { "enum": ["bool", "u16", "i16", "bitfield", "u32", "i32", "f32", "u64", "i64", "f64", "string"] },
        "length": { "type": "integer", "minimum": 1, "maximum": 125 },
        "word_order": { "enum": ["ABCD", "CDAB", "BADC", "DCBA"] },
        "scale": { "type": "number", "not": { "const": 0 } },
        "offset": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 9 },
        "valid_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "display_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "invalid_sentinels": { "type": "array", "items": { "type": "integer" } },
        "bits": {
          "type": "object",
          "propertyNames": { "pattern": "^(0|[1-9]|1[0-5])$" },
          "additionalProperties": { "$ref": "#/$defs/text80" }
        },
        "access": { "enum": ["read", "read_write"] },
        "write": { "$ref": "#/$defs/write" },
        "poll": { "enum": ["fast", "normal", "slow"] },
        "source_page": { "$ref": "#/$defs/text40" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["u32", "i32", "f32", "u64", "i64", "f64"] } }, "required": ["type"] },
          "then": { "required": ["word_order"] }
        },
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "then": { "required": ["length"], "properties": { "word_order": { "enum": ["ABCD", "BADC"] } } },
          "else": { "not": { "required": ["length"] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["bool", "u16", "i16", "bitfield"] } }, "required": ["type"] },
          "then": { "not": { "required": ["word_order"] } }
        },
        {
          "if": { "properties": { "type": { "not": { "const": "bitfield" } } } },
          "then": { "not": { "required": ["bits"] } }
        },
        {
          "if": { "properties": { "table": { "enum": ["coil", "discrete_input"] } }, "required": ["table"] },
          "then": { "properties": { "type": { "const": "bool" } } },
          "else": { "properties": { "type": { "not": { "const": "bool" } } } }
        },
        {
          "if": { "properties": { "access": { "const": "read_write" } }, "required": ["access"] },
          "then": { "required": ["write"], "properties": { "table": { "enum": ["coil", "holding_register"] } } },
          "else": { "not": { "required": ["write"] } }
        }
      ]
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "role"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "allowed_values": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "risk": { "enum": ["low", "medium", "high"] },
        "role": { "enum": ["operator", "commissioner"] },
        "confirm": { "const": true },
        "readback": { "const": true }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "register", "readback_register"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["run", "stop", "setpoint", "reset_fault", "mode"] },
        "label": { "$ref": "#/$defs/text80" },
        "register": { "$ref": "#/$defs/id" },
        "value": { "type": "number" },
        "readback_register": { "$ref": "#/$defs/id" },
        "expected": { "type": "number" },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["register", "tolerance", "timeout_ms"],
          "properties": {
            "register": { "$ref": "#/$defs/id" },
            "tolerance": { "type": "number", "minimum": 0 },
            "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 3600000 },
            "value": { "type": "number" },
            "bit": { "type": "integer", "minimum": 0, "maximum": 15 }
          },
          "dependentSchemas": { "bit": { "required": ["value"], "properties": { "value": { "enum": [0, 1] } } } }
        }
      },
      "if": { "properties": { "kind": { "const": "setpoint" } }, "required": ["kind"] },
      "then": { "not": { "required": ["value"] } },
      "else": { "required": ["value"] }
    },
    "commSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "apply"],
      "properties": {
        "register": { "$ref": "#/$defs/id" },
        "apply": { "enum": ["immediate", "after_reboot", "unknown"] },
        "codes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "type": "integer", "minimum": 300, "maximum": 3000000 }
        }
      }
    }
  }
}
