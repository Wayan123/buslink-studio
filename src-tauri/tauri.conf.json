{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BusLink Studio",
  "mainBinaryName": "buslink-studio",
  "version": "0.1.0",
  "identifier": "id.co.arkamaya.buslink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/check-release-features.mjs --artifact --optional src-tauri/target/release/buslink-studio.exe",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BusLink Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PT Arkamaya Guna Saharsa",
    "copyright": "Copyright 2026 PT Arkamaya Guna Saharsa. Apache-2.0.",
    "license": "Apache-2.0",
    "shortDescription": "Modbus RTU/TCP workbench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
